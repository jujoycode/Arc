# cp deploy.env.example .env.deploy; chmod 600 .env.deploy
# Generate independent passwords before starting the installation.
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
ARC_PUBLIC_URL=http://localhost:8085
ARC_HTTP_BIND=127.0.0.1
ARC_HTTP_PORT=8085
ARC_IMAGE_TAG=local
ARC_MAIL_FROM=Arc <no-reply@localhost>

# Local rehearsal: --profile local-mail. Replace with real SMTP for operation.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
ARC_MAILPIT_PORT=8026
